{
  "name": "scrapple",
  "version": "0.0.10",
  "description": "Local Apple Developer Documentation scraper and search tool",
  "type": "module",
  "bin": {
    "scrapple": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "node --test dist/test/*.test.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "apple",
    "documentation",
    "scraper",
    "search",
    "wwdc"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "commander": "^15.0.0",
    "playwright": "^1.60.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "file:./stubs/sharp"
    }
  },
  "bundleDependencies": [
    "@huggingface/transformers"
  ]
}
